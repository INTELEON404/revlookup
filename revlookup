#!/usr/bin/env python3
import argparse
import ipaddress
import socket
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path

__version__ = "1.3"
__project__ = "revlookup"
__author__ = "INTELEON404"

MAX_IPV4_HOSTS = 65536
MAX_IPV6_HOSTS = 65536
DEFAULT_THREADS = 100
MAX_THREADS = 5000

def resolve(host):
    """Resolve domain to IPv4/IPv6 addresses in deterministic order."""
    try:
        addrs = socket.getaddrinfo(host, 0)
        seen = set()
        result = []
        for addr in addrs:
            ip = addr[4][0]
            if ip not in seen:
                seen.add(ip)
                result.append(ip)
        return result
    except (socket.gaierror, OSError):
        return []

def ptr(ip):
    """Perform reverse DNS lookup."""
    try:
        return socket.gethostbyaddr(ip)[0]
    except (socket.herror, socket.gaierror, OSError):
        return None

def load_targets(args):
    """Expand all input sources into a deduplicated IP list."""
    raw = []
    if args.target:
        raw = [args.target]
    elif args.file:
        try:
            raw = [l.strip() for l in Path(args.file).read_text(encoding="utf-8").splitlines()
                   if l.strip() and not l.strip().startswith('#')]
        except OSError as e:
            print(f"[!] Cannot read file: {e}", file=sys.stderr)
            sys.exit(1)
    elif args.cidr:
        raw = [args.cidr]

    ips = []
    seen = set()
    for item in raw:
        if '/' in item:
            try:
                net = ipaddress.ip_network(item, strict=False)
                limit = MAX_IPV4_HOSTS if net.version == 4 else MAX_IPV6_HOSTS
                if net.num_addresses > limit:
                    print(f"[!] CIDR too large: {item}", file=sys.stderr)
                    continue
                for addr in net.hosts():
                    s = str(addr)
                    if s not in seen:
                        seen.add(s)
                        ips.append(s)
            except ValueError:
                print(f"[!] Invalid CIDR: {item}", file=sys.stderr)
            continue

        try:
            ipaddress.ip_address(item)
            if item not in seen:
                seen.add(item)
                ips.append(item)
            continue
        except ValueError:
            pass

        resolved = resolve(item)
        if not resolved:
            print(f"[!] Cannot resolve: {item}", file=sys.stderr)
            continue
        for ip in resolved:
            if ip not in seen:
                seen.add(ip)
                ips.append(ip)

    return ips

def draw_bar(done, total, found, failed, file=sys.stderr):
    """Render a simple progress bar to stderr."""
    pct = done * 100 // total
    bar = "●" * (pct // 10) + "○" * (10 - pct // 10)
    print(f"\r[{bar}] {pct}% | {done}/{total} | Found: {found} | Failed: {failed}",
          end="", flush=True, file=file)

def main():
    parser = argparse.ArgumentParser(
        description=f"{__project__} v{__version__} - Reverse DNS lookup",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    g = parser.add_mutually_exclusive_group(required=True)
    g.add_argument("-t", "--target", help="Single IP or domain")
    g.add_argument("-f", "--file", help="File with IPs/domains/CIDRs")
    g.add_argument("-c", "--cidr", help="CIDR range (e.g. 8.8.8.0/24)")
    parser.add_argument("-o", "--output", help="Save results to file")
    parser.add_argument("-td", "--threads", type=int, default=DEFAULT_THREADS,
                        help=f"Max worker threads (default: {DEFAULT_THREADS})")
    parser.add_argument("-s", "--silent", action="store_true", help="No banner/progress")
    args = parser.parse_args()

    if not args.silent:
        print(f"{__project__} v{__version__}", file=sys.stderr)

    args.threads = max(1, min(MAX_THREADS, args.threads))
    targets = load_targets(args)

    if not targets:
        print("[!] No valid targets", file=sys.stderr)
        sys.exit(1)

    if not args.silent:
        print(f"[+] Scanning {len(targets)} target(s) with {args.threads} worker(s)...",
              file=sys.stderr)

    total = len(targets)
    found = failed = 0
    out = None
    if args.output:
        try:
            out = open(args.output, "w", encoding="utf-8", buffering=1)
        except OSError as e:
            print(f"[!] Cannot open output file: {e}", file=sys.stderr)
            sys.exit(1)

    is_tty = sys.stderr.isatty() and not args.silent

    try:
        with ThreadPoolExecutor(max_workers=args.threads) as ex:
            futures = {ex.submit(ptr, ip): ip for ip in targets}
            for fut in as_completed(futures):
                ip = futures[fut]
                host = fut.result()
                if host:
                    found += 1
                    print(f"{ip} -> {host}")
                    if out:
                        out.write(f"{ip}\t{host}\n")
                else:
                    failed += 1

                if is_tty:
                    draw_bar(found + failed, total, found, failed)

        if is_tty:
            print(file=sys.stderr)

    except KeyboardInterrupt:
        if is_tty:
            print(file=sys.stderr)
        print("[!] Interrupted by user", file=sys.stderr)
        sys.exit(130)
    finally:
        if out:
            out.close()

if __name__ == "__main__":
    main()
