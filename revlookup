#!/usr/bin/env python3
import argparse
import ipaddress
import socket
import sys
from concurrent.futures import FIRST_COMPLETED, ThreadPoolExecutor, wait
from pathlib import Path
from threading import Lock
from typing import Iterator, List, Optional


__version__ = "1.3"
__project__ = "revlookup"
__author__ = "INTELEON404"


DEFAULT_THREADS = 100
MAX_THREADS = 5000

output_lock = Lock()


def resolve(host: str) -> List[str]:
    """Resolve a domain to unique IPv4/IPv6 addresses."""
    try:
        addresses = socket.getaddrinfo(host, 0)
        seen = set()
        results = []
        for address in addresses:
            ip = address[4][0]
            if ip not in seen:
                seen.add(ip)
                results.append(ip)
        return results
    except (socket.gaierror, OSError):
        return []


def ptr(ip: str) -> Optional[str]:
    """Perform reverse DNS lookup."""
    try:
        return socket.gethostbyaddr(ip)[0]
    except (socket.herror, socket.gaierror, OSError):
        return None


def get_raw_items(args: argparse.Namespace) -> List[str]:
    """Extract raw input strings from arguments."""
    raw = []
    if args.target:
        raw = [args.target]
    elif args.file:
        try:
            raw = [
                line.strip()
                for line in Path(args.file).read_text(encoding="utf-8").splitlines()
                if line.strip() and not line.strip().startswith("#")
            ]
        except OSError:
            pass
    elif args.cidr:
        raw = [args.cidr]
    return raw


class TargetManager:
    """Manages deduplicated target generation and dynamic total estimation."""

    def __init__(self, raw: List[str]):
        self.raw = raw
        self.total = self._estimate(raw)
        self.seen = set()

    def _estimate(self, raw: List[str]) -> int:
        """Estimate the maximum number of targets to process for the progress bar."""
        t = 0
        for item in raw:
            if "/" in item:
                try:
                    net = ipaddress.ip_network(item, strict=False)
                    if net.prefixlen == net.max_prefixlen:
                        t += 1
                    else:
                        if net.version == 4:
                            t += max(0, net.num_addresses - 2)
                        else:
                            t += max(0, net.num_addresses - 1)
                except ValueError:
                    pass
            else:
                try:
                    ipaddress.ip_address(item)
                    t += 1
                except ValueError:
                    # Domain estimate: counts as at least 1 resolution attempt
                    t += 1
        return t

    def generate(self) -> Iterator[str]:
        """Yield targets while maintaining exact total count and uniqueness."""
        for item in self.raw:
            # Handle CIDR ranges
            if "/" in item:
                try:
                    net = ipaddress.ip_network(item, strict=False)
                    if net.prefixlen == net.max_prefixlen:
                        ip = str(net.network_address)
                        if ip not in self.seen:
                            self.seen.add(ip)
                            yield ip
                        else:
                            self.total -= 1
                    else:
                        for address in net.hosts():
                            ip = str(address)
                            if ip not in self.seen:
                                self.seen.add(ip)
                                yield ip
                            else:
                                self.total -= 1
                except ValueError:
                    pass
            
            # Handle direct IPs or Domains
            else:
                try:
                    ip = str(ipaddress.ip_address(item))
                    if ip not in self.seen:
                        self.seen.add(ip)
                        yield ip
                    else:
                        self.total -= 1
                    continue
                except ValueError:
                    pass

                # Domain resolution
                resolved = resolve(item)
                added = 0
                for ip in resolved:
                    if ip not in self.seen:
                        self.seen.add(ip)
                        yield ip
                        added += 1
                
                # Correct the initial +1 domain estimate if it resolved to multiple/zero IPs
                self.total += (added - 1)


def draw_progress(done: int, total: int, found: int) -> None:
    """Render a thin in-place progress indicator."""
    if total <= 0:
        return

    percent = min(100, done * 100 // total)
    filled = (percent * 20) // 100
    empty = 20 - filled

    bar = "█" * filled + "░" * empty

    status = (
        f"▌ {percent:3d}% │ "
        f"{bar} │ "
        f"{done}/{total} │ "
        f"{found} found"
    )

    sys.stderr.write(f"\r\033[2K{status}")
    sys.stderr.flush()


def clear_progress() -> None:
    """Completely remove the current progress line."""
    sys.stderr.write("\r\033[2K\r")
    sys.stderr.flush()


def write_result(line: str, output) -> None:
    """Write a result immediately to stdout and file safely across threads."""
    with output_lock:
        sys.stdout.write(f"{line}\n")
        sys.stdout.flush()
        if output:
            output.write(f"{line}\n")
            output.flush()


def main() -> int:
    """Main entry point."""
    parser = argparse.ArgumentParser(
        prog=__project__,
        description=f"{__project__} - Concurrent reverse DNS lookup",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )

    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("-t", "--target", metavar="IP/DOMAIN", help="Single IP or domain")
    group.add_argument("-f", "--file", metavar="FILE", help="File with IPs, domains, or CIDRs")
    group.add_argument("-c", "--cidr", metavar="CIDR", help="CIDR range (e.g., 8.8.8.0/24)")
    
    parser.add_argument("-o", "--output", metavar="FILE", help="Save results to file")
    
    parser.add_argument(
        "-td", "--threads", type=int, default=DEFAULT_THREADS, metavar="N",
        help=f"Worker threads (default: {DEFAULT_THREADS}, max: {MAX_THREADS})"
    )
    
    parser.add_argument("-s", "--silent", action="store_true", help="Disable progress output")
    parser.add_argument("-v", "--version", action="version", version=f"{__project__} v{__version__}")

    args = parser.parse_args()
    args.threads = max(1, min(MAX_THREADS, args.threads))

    raw_items = get_raw_items(args)
    manager = TargetManager(raw_items)

    if manager.total <= 0:
        return 1

    targets_iter = manager.generate()

    completed = 0
    found = 0
    output = None

    if args.output:
        try:
            output = open(args.output, "w", encoding="utf-8", buffering=1)
        except OSError:
            return 1

    is_tty = sys.stdout.isatty() and sys.stderr.isatty() and not args.silent

    try:
        if is_tty:
            draw_progress(0, manager.total, 0)

        with ThreadPoolExecutor(max_workers=args.threads) as executor:
            # Dictionary maps Future -> IP address
            pending = {}

            # Pre-fill initial workload bounding max memory
            for _ in range(args.threads):
                try:
                    ip = next(targets_iter)
                    pending[executor.submit(ptr, ip)] = ip
                except StopIteration:
                    break

            # Sliding window execution
            while pending:
                done, _ = wait(pending.keys(), return_when=FIRST_COMPLETED)

                for future in done:
                    ip = pending.pop(future)
                    try:
                        host = future.result()
                    except Exception:
                        host = None

                    completed += 1

                    if host:
                        found += 1
                        if is_tty:
                            clear_progress()
                            
                        # Format output: Pad IP string to 15 chars for clean alignment
                        write_result(f"{ip:<15} → {host}", output)

                    # Replenish queue
                    try:
                        next_ip = next(targets_iter)
                        pending[executor.submit(ptr, next_ip)] = next_ip
                    except StopIteration:
                        pass
                
                if is_tty:
                    draw_progress(completed, manager.total, found)

        if is_tty:
            clear_progress()
            
        sys.stdout.flush()

    except KeyboardInterrupt:
        if is_tty:
            clear_progress()
        return 130

    finally:
        if output:
            output.close()

    return 0


if __name__ == "__main__":
    sys.exit(main())
